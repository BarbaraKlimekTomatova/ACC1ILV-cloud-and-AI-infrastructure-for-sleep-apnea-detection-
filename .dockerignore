# Build context of every Dockerfile = the repo root. Keep it small and the same as a clean
# git checkout: local venvs, caches and generated files stay out.
.git
.github
.venv
.env
**/__pycache__
**/*.pyc
.pytest_cache
notebooks
diagrams
doc
ADR
# generated by data/03_to_kafka_messages.py; the device-simulator image makes its own
kafka/messages
