@startuml UC1
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam sequence {
  LifeLineBorderColor #BBBBBB
  ParticipantBorderColor #666666
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #666666
  ActorBackgroundColor #FFFFFF
  GroupBorderColor #999999
}
skinparam database {
  BorderColor #666666
  BackgroundColor #FFFFFF
}
skinparam queue {
  BorderColor #666666
  BackgroundColor #FFFFFF
}
skinparam note {
  BorderColor #BBBBBB
  BackgroundColor #FFFFFF
}
hide footbox
title UC1 – Send night data

participant "Home device\n(simulator)" as SIM
queue "Message queue\n(Kafka)" as K
participant "Analysis service\n(apnea-detector)" as DET
database "Database" as DB

loop every minute of the night
  SIM -> K : oxygen + breathing values
  K -> DET : passes them on
  DET -> DB : saves the raw data
end

note over K : Keeps every message safe\n(3 copies, 7 days)
@enduml
