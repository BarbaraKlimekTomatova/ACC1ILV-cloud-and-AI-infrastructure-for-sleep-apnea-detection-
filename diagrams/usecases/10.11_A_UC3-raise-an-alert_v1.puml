@startuml UC3
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam sequence {
  LifeLineBorderColor #BBBBBB
  ParticipantBorderColor #666666
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #666666
  ActorBackgroundColor #FFFFFF
  GroupBorderColor #999999
}
skinparam database {
  BorderColor #666666
  BackgroundColor #FFFFFF
}
skinparam queue {
  BorderColor #666666
  BackgroundColor #FFFFFF
}
skinparam note {
  BorderColor #BBBBBB
  BackgroundColor #FFFDE7
}
hide footbox
title UC3 – Raise an alert

participant "Analysis service\n(alert check)" as DET
participant "Alert service" as ALR
database "Database" as DB
participant "Doctor dashboard" as DASH
actor "Doctor" as DOC

group #FED7D7 oxygen below 80 %
  DET -> ALR : urgent alert (ZeroMQ)
  ALR -> DB : saves the alert
  DASH -> DOC : shows the alert right away
end

note over DET : Checks every minute.\nNever waits, even when\nthe analysis is paused.
@enduml
