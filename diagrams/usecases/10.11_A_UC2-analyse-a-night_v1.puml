@startuml UC2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam BoxPadding 10
skinparam sequence {
  LifeLineBorderColor #888888
  ParticipantBorderColor #555555
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #555555
  ActorBackgroundColor #FFFFFF
  GroupBorderColor #777777
  GroupHeaderFontColor #333333
}
skinparam database {
  BorderColor #555555
  BackgroundColor #FFFFFF
}
skinparam queue {
  BorderColor #555555
  BackgroundColor #FFFFFF
}
skinparam note {
  BorderColor #999999
  BackgroundColor #FFFDE7
}
title UC2 – Analyse a night
autonumber

database "etcd" as ETCD
queue "Kafka" as K
participant "apnea-detector" as DET
participant "ahi-triage" as TRI
database "PostgreSQL" as DB
participant "doctor-dashboard" as DASH

loop every minute
  ETCD --> DET : reads carbon mode
  alt #E5E7EB low_carbon
    DET -> DET : accurate model + CO2 (CodeCarbon)
  else high_carbon, 08:00 deadline far
    DET -> DET : pause analysis –\nminutes wait in Kafka
  else high_carbon, 08:00 deadline close
    DET -> DET : fast model + CO2 (CodeCarbon)
  end
  group #FFE4C4 apnea events
    DET -> K : apnea-events: event of the minute
    K -> TRI : apnea-events
    TRI -> TRI : count events
  end
end

opt #D4F5D4 last minute of the night (is_last = true)
  TRI -> TRI : AHI = events / hours of sleep\nseverity: normal <5 · mild 5–15 ·\nmoderate 15–30 · severe ≥30
  TRI -> DB : SQL: save result
  TRI -> K : night-results
  K -> DASH : night-results
  DASH -> DASH : refresh patient list
end
@enduml
