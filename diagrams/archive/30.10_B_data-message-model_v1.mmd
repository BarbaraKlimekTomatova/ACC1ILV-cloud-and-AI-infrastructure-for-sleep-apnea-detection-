%% Data model + message model in one diagram. Dashed areas: what is stored (PostgreSQL), what flows between
%% services (Kafka / ZeroMQ messages) and the shared carbon mode (etcd).
classDiagram
    direction LR

    namespace DATA_MODEL_PostgreSQL_tables {
        class Patient {
            <<table: patients · A>>
            +patient_id: str PK
            +label: str (no real name)
        }
        class RawNight {
            <<table: raw_nights · B>>
            +night_id: str PK
            +patient_id: str FK
            +spo2: json
            +breathing: json
        }
        class Result {
            <<table: results · A>>
            +night_id: str PK, FK
            +patient_id: str FK
            +ahi: float
            +severity: str
            +apnea_count: int
            +hypopnea_count: int
            +models_used: str
        }
        class Alert {
            <<table: alerts · B>>
            +id: int PK
            +night_id: str FK
            +minute: int
            +spo2: float
        }
        class Decision {
            <<table: decisions = audit log · A>>
            +id: int PK
            +night_id: str FK
            +action: approved | corrected
            +final_severity: str
            +doctor: str
            +decided_at: datetime
        }
    }

    namespace MESSAGE_MODEL_Kafka_and_ZeroMQ {
        class RawSignalsMsg {
            <<Kafka: raw-signals · A → B>>
            +patient_id: str key
            +night_id: str
            +minute: int
            +is_last: bool
            +spo2: float[60]
            +breathing: float[60]
            +label: str
        }
        class ApneaEventsMsg {
            <<Kafka: apnea-events · B → A>>
            +patient_id: str key
            +night_id: str
            +minute: int
            +event: apnea | hypopnea | none
            +model: fast | accurate
            +carbon_mode: str
            +is_last: bool
        }
        class NightResultsMsg {
            <<Kafka: night-results · A → A>>
            +patient_id: str key
            +night_id: str
            +ahi: float
            +severity: str
        }
        class AlertMsg {
            <<ZeroMQ: alert · B → B>>
            +patient_id: str
            +night_id: str
            +minute: int
            +spo2: float
        }
    }

    namespace SHARED_STATE_etcd {
        class CarbonMode {
            <<etcd key: carbon_mode · B>>
            +value: low_carbon | high_carbon
            +intensity_g_per_kwh: float
        }
    }

    Patient "1" -- "1..*" RawNight : records
    RawNight "1" -- "0..1" Result : analysed into
    RawNight "1" -- "0..*" Alert : raised during
    Result "1" -- "0..*" Decision : reviewed in

    RawSignalsMsg "1..*" ..> "1" RawNight : saved as one night
    RawSignalsMsg "1" ..> "1" ApneaEventsMsg : analysed into
    RawSignalsMsg "1" ..> "0..1" AlertMsg : SpO2 below 80 %
    ApneaEventsMsg "1..*" ..> "1" NightResultsMsg : counted into
    NightResultsMsg ..> Result : stored as
    AlertMsg ..> Alert : stored as
    CarbonMode ..> ApneaEventsMsg : decides model and timing

    note "LEGEND · Dashed areas: DATA MODEL = what is stored · MESSAGE MODEL = what flows between services · SHARED STATE = etcd<br/>Solid line = relation between tables (foreign key, with multiplicity) · Dashed arrow = what a message turns into<br/>Header: table or channel · owner (A = Aliénor, B = Barbara; A → B = sent by A, read by B)"

    style Patient fill:#ece4fb,stroke:#7c5cc4,color:#1d1533
    style RawNight fill:#ece4fb,stroke:#7c5cc4,color:#1d1533
    style Result fill:#ece4fb,stroke:#7c5cc4,color:#1d1533
    style Alert fill:#ece4fb,stroke:#7c5cc4,color:#1d1533
    style Decision fill:#ece4fb,stroke:#7c5cc4,color:#1d1533
    style RawSignalsMsg fill:#e2eefc,stroke:#3b78c4,color:#0f1f33
    style ApneaEventsMsg fill:#e2eefc,stroke:#3b78c4,color:#0f1f33
    style NightResultsMsg fill:#e2eefc,stroke:#3b78c4,color:#0f1f33
    style AlertMsg fill:#e2eefc,stroke:#3b78c4,color:#0f1f33
    style CarbonMode fill:#e3f4e6,stroke:#3e9a52,color:#10291a
