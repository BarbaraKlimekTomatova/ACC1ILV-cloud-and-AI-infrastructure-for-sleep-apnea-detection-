@startuml
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam sequenceMessageAlign center
skinparam sequence {
  LifeLineBorderColor #BBBBBB
  ParticipantBorderColor #666666
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #666666
  ActorBackgroundColor #FFFFFF
  GroupBorderColor #999999
  ArrowColor #444444
}
skinparam database {
  BorderColor #666666
  BackgroundColor #FFFFFF
}
skinparam queue {
  BorderColor #666666
  BackgroundColor #FFFFFF
}
skinparam note {
  BorderColor #BBBBBB
  BackgroundColor #FFFFFF
}
hide footbox
title UC7 – Retrain model

actor "Operator / Team" as OP
participant "Kubernetes CronJob\n(Sunday 02:00)" as CRON
queue "carbon-signal" as CS
participant "model-trainer" as TR
database "PostgreSQL" as DB
participant "GitHub Actions\n(F1 gate)" as GA
participant "apnea-detector" as DET

alt triggered_by = schedule
  CRON -> TR : start Job
else triggered_by = manual or drift
  OP -> TR : start Job
end

loop until low_carbon
  CS ->> TR : carbon mode
end

TR -> DB : reads raw_nights +\ncorrections in decisions\n(action = correct)
DB --> TR : training nights
TR -> TR : trains the model,\nF1 on held-out nights
TR -> DB : new row in model_versions\n(status = pending)
TR -> GA : model file + F1

alt F1 above threshold
  GA -> DB : status = approved
  GA -> DET : builds and deploys\nthe new version
else F1 too low
  GA -> DB : status = rejected
end

note over TR : CodeCarbon measures kwh and gco2\nof the training
legend bottom right
  ->> asynchronous (Kafka)
  -> synchronous call
endlegend
@enduml
